# Copy to C:\ProgramData\BackAisle\secrets.env (preferred) or secrets.env next to this file.
# Never commit the filled-in file. IIS must not serve this path.

UPS_HOST=
UPS_WEB_USER=
UPS_WEB_PASS=
SNMPV3_USER=
SNMPV3_AUTH_PROTO=SHA
SNMPV3_PRIV_PROTO=AES
SNMPV3_AUTH_PASS=
SNMPV3_PRIV_PASS=
SNMPV3_PORT=161
APP_ADMIN_USER=admin
APP_ADMIN_PASS=
APP_VIEWER_PASS=viewer
PYTHON=
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=backaisle@localhost
SMTP_TO=
SMTP_USER=
SMTP_PASS=
AllowMultiWrite=false
# How many different UPS cards to write at once (1-8). Same card is never written twice at once.
WRITE_WORKERS=4
# Extra attempts after a transient web/SCP/FTP failure. 0 disables retries.
WRITE_RETRIES=2
